{
  "model_name": "BridgeAdaptCLIP-v2.0",
  "method": "Decoupled Broad-Fine Residual Calibration",
  "fine_base": "frozen BridgeAdaptCLIP-v1.3 validation-selected Epoch 3",
  "broad_feature": "AvgPool v1.3 joint feature from 256x256 to 128x128, concatenate P_fine and P_row0",
  "broad_block": "3x3 Conv-GN-GELU plus dilation-2 3x3 Conv-GN-GELU",
  "fusion": "Z_final = Z_fine - sigmoid(A_broad) * softplus(R_broad)",
  "broad_correction": "non-positive only",
  "broad_gate_target": "stopgrad((1-Y)*P_fine)",
  "loss_weights": {"focal": 1.0, "dice": 1.0, "broad_fp_gate": 0.1, "positive_preserve": 0.05, "negative_only_ranking": 0.01},
  "hard_positive_reference": 256,
  "hard_negatives": 256,
  "clip_input_size": 518,
  "structural_input_size": 1024,
  "metric_resolution": 1024,
  "optimizer": "Adam",
  "optimizer_betas": [0.5, 0.999],
  "learning_rate": 0.0003,
  "physical_batch_size": 4,
  "gradient_accumulation_steps": 2,
  "effective_batch_size": 8,
  "epochs": 15,
  "train_seed": 10,
  "checkpoint_selection": "validation overall native-1024 P-AP only",
  "test_policy": "one development-test evaluation after selection"
}
