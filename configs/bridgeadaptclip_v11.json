{
  "model_name": "BridgeAdaptCLIP-v1.1",
  "research_question": "Can a spatially gated structural logit residual recover thin cracks without replacing the stable Row-0 semantic prediction?",
  "baseline": "Original AdaptCLIP Protocol-v2 Row0 Epoch 14",
  "semantic_base": {
    "clip": "frozen",
    "visual_adapter": "frozen_from_row0_epoch14",
    "textual_adapter": "frozen_from_row0_epoch14",
    "prompt_strategy": "original_adaptclip_prompt_ensemble",
    "image_score": "exact_row0_output"
  },
  "reference_mode": "0-reference",
  "clip_input_size": 518,
  "structural_input_size": 1024,
  "metric_resolution": 1024,
  "structural_channels": 128,
  "semantic_projection_channels": 128,
  "strip_kernel": 5,
  "direction_embedding": false,
  "gate_inputs": ["F_high", "F_sem", "P_row0"],
  "fusion_formula": "Z_final = logit(P_row0) + sigmoid(G) * R",
  "residual": "bidirectional_unbounded",
  "residual_initialization": "weight=0,bias=0",
  "gate_initialization": "weight=0,bias=-4",
  "optimizer": "Adam",
  "optimizer_betas": [0.5, 0.999],
  "new_module_learning_rate": 0.0003,
  "weight_decay": 0.0,
  "physical_batch_size": 4,
  "gradient_accumulation_steps": 2,
  "effective_batch_size": 8,
  "max_epochs": 15,
  "train_seed": 10,
  "loss": {
    "image_ce_weight": 0.0,
    "pixel_focal_weight": 1.0,
    "pixel_dice_weight": 1.0,
    "gated_residual_l1_weight": 0.0,
    "focal_positive_alpha": 0.75,
    "focal_gamma": 2.0,
    "native_pixel_loss_precision": "float32"
  },
  "checkpoint_selection": "val_native1024_pixel_ap",
  "test_policy": "once_after_validation_selection",
  "success_targets_percent": {
    "overall_P-AP": ">70",
    "Crack_P-AP": ">=15",
    "Spalling_P-AP": ">=72",
    "Corrosion_P-AP": ">=60",
    "Efflorescence_P-AP": ">=43",
    "Macro_diagnostic_P-AP": ">47",
    "I-AUROC": "approximately 93.53"
  }
}
