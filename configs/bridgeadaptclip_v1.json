{
  "model_name": "BridgeAdaptCLIP-v1",
  "research_question": "Can native-resolution structural refinement improve thin bridge crack localization while preserving AdaptCLIP anomaly semantics?",
  "baseline": "Original AdaptCLIP Protocol-v2 Row0",
  "reference_mode": "0-reference",
  "clip_input_size": 518,
  "structural_input_size": 1024,
  "metric_resolution": 1024,
  "clip_backbone": "ViT-L/14",
  "clip_train_mode": "frozen",
  "semantic_adapters": ["VisualAdapter", "TextualAdapter"],
  "prompt_query_adapter_in_pixel_path": false,
  "normal_static_anchor": "a photo of a normal concrete bridge surface",
  "anomaly_static_anchor": "a photo of a damaged concrete bridge surface",
  "semantic_grid": [37, 37],
  "fusion_channels": 128,
  "structural_channels": 128,
  "strip_kernel": 5,
  "edge_gate": true,
  "direction_embedding": false,
  "srf_residual": "(1 + alpha_s) * F0_up",
  "srf_attention_initialization": "weight=0,bias=-4",
  "optimizer": "Adam",
  "optimizer_betas": [0.5, 0.999],
  "adapter_learning_rate": 0.001,
  "new_module_learning_rate": 0.001,
  "weight_decay": 0.0,
  "physical_batch_size": 4,
  "gradient_accumulation_steps": 2,
  "effective_batch_size": 8,
  "max_epochs": 15,
  "train_seed": 10,
  "loss": {
    "image_ce_weight": 1.0,
    "pixel_focal_weight": 1.0,
    "pixel_dice_weight": 1.0,
    "focal_positive_alpha": 0.75,
    "focal_gamma": 2.0,
    "native_pixel_loss_precision": "float32"
  },
  "checkpoint_selection": "val_native1024_pixel_ap",
  "test_policy": "once_after_validation_selection"
}
